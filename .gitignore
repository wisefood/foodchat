__pycache__/*
__pycache__
.claude
.env
*/data
*/VECTORSTORE
RECSYS26_PLAN.md

.coverage

# Local SQLite session store — DATABASE_URL defaults to ./foodchat.db, so a
# dev run or a test that forgets its tmpdir drops one next to the code.
*.db
foodchat.db

# conftest builds its test database in `tempfile.mkdtemp(prefix="foodchat-tests-")`.
# That normally lands in /tmp, but it follows TMPDIR — and with TMPDIR pointing
# here it drops a 300KB directory of throwaway sessions next to the source,
# where it shows up as untracked and makes a clean tree look dirty.
foodchat-tests-*/

# Local only: the demo gateway's cached bearer token, and IDE settings.
.wisefood_demo_token
.idea/
