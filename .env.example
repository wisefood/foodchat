# =============================================================================
# FoodChat Environment Configuration
# =============================================================================
# Copy this file to .env and configure your settings
# cp .env.example .env

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
HOST=0.0.0.0
PORT=8000
DEBUG=false
WORKERS=1

# =============================================================================
# LLM CONFIGURATION (Ollama)
# =============================================================================
# Base URL for Ollama API (use host.docker.internal when running in Docker)
OLLAMA_BASE_URL=http://localhost:11434

# Main chat model
LLM_MODEL=llama3.2:latest
LLM_TEMPERATURE=0.0

# Router/classifier model
ROUTER_MODEL=llama3.2
ROUTER_TEMPERATURE=0.0

# Grader model for document scoring
GRADER_MODEL=llama3.2
GRADER_TEMPERATURE=0.0

# Chatbot model (for non-RAG responses)
CHATBOT_MODEL=llama3.2:latest
CHATBOT_TEMPERATURE=0.7

# Evaluator model
EVALUATOR_MODEL=llama3.2:3b-instruct-q8_0
EVALUATOR_TEMPERATURE=0.0

# =============================================================================
# EMBEDDING CONFIGURATION
# =============================================================================
# Ollama embedding model
EMBEDDING_MODEL=nomic-embed-text:latest

# HuggingFace embedding model (for fine-tuned embeddings)
HUGGINGFACE_EMBEDDING_MODEL=davanstrien/autotrain-recipes-2451975973

# =============================================================================
# RETRIEVAL CONFIGURATION
# =============================================================================
# Retrieval method: similarity, mmr, similarity_score_threshold
RETRIEVAL_METHOD=similarity

# Maximum documents to retrieve
MAX_RETRIEVAL=3

# Query method: standard, multiquery
QUERY_METHOD=standard

# MMR lambda parameter (0-1, only for mmr retrieval)
MMR_LAMBDA=0.5

# Hybrid search settings
HYBRID_SEARCH_ENABLED=false
KEYWORD_SEARCH_WEIGHT=0.5
VECTOR_SEARCH_WEIGHT=0.5

# =============================================================================
# VECTORSTORE CONFIGURATION
# =============================================================================
# Vectorstore type: chroma, faiss, milvus
VECTORSTORE_TYPE=chroma

# =============================================================================
# DATA CONFIGURATION
# =============================================================================
# Data type: csv, pdf
DATA_TYPE=csv

# Dataset name: hummus, culinary
DATASET=hummus

# PDF source name (without extension)
PDF_SOURCE_NAME=20_International_Recipes

# CSV file paths (relative to data directory)
# CSV_HUMMUS_PATH=./data/data_kg.csv
# CSV_CULINARY_PATH=./data/sample_CulinaryDB.csv

# =============================================================================
# NEO4J CONFIGURATION
# =============================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# =============================================================================
# RAG CONFIGURATION
# =============================================================================
ADAPTIVE_RAG_ENABLED=false
MAX_RAG_ITERATIONS=3

# =============================================================================
# PDF PROCESSING CONFIGURATION
# =============================================================================
# Split method: page_split, recipe_split, recursive_character_split
PDF_SPLIT_METHOD=recipe_split

# Chunk settings for recursive character split
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# =============================================================================
# GRADIO UI CONFIGURATION
# =============================================================================
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
# LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
