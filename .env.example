# =============================================================================
# FoodChat Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Every setting the service reads is listed here — if you add an os.getenv()
# anywhere in src/, document it in this file.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# CRITICAL | ERROR | WARNING | INFO | DEBUG. Anything else falls back to
# INFO rather than failing the boot. The Dockerfile sets DEBUG in the dev
# stage and INFO in prod.
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Persistence (SQLite file by default; PostgreSQL DSN in production, M5)
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./foodchat.db
# DATABASE_URL=postgresql://user:password@localhost:5432/foodchat
SESSION_MAX_MESSAGES=200

# -----------------------------------------------------------------------------
# Groq LLM API (all agents — see src/agents.py, src/backend/groq.py)
# -----------------------------------------------------------------------------
# RESOLUTION ORDER for model and temperature, narrowest wins:
#
#   1. an explicit constructor argument      (tests only)
#   2. FOODCHAT_FAST_MODEL                   (the five cheap extractors only)
#   3. FOODCHAT_LLM_MODEL / _TEMPERATURE     (every other agent)
#   4. GROQ_DEFAULT_MODEL / _TEMPERATURE     (the shipped default)
#
# Leave a level UNSET to inherit the next one down. Only GROQ_DEFAULT_* carries
# a hardcoded value, in backend/groq.py; do not add a literal fallback at any
# other level. A second os.getenv with its own default is what made
# GROQ_DEFAULT_MODEL and GROQ_DEFAULT_TEMPERATURE unreachable for so long —
# they were documented and read, but every call site shadowed them, so setting
# them changed nothing.
GROQ_API_KEY=gsk_your_api_key_here

# The default for every agent that reasons: the batch plan grader, the intent
# orchestrator, the diversity/guideline judges, the query reconciler and the
# three prose writers.
#
# Groq shut down llama-3.3-70b-versatile and llama-3.1-8b-instant on
# 2026-08-16; both were this service's defaults. Substitutes per Groq's
# migration notice: 70b-versatile → openai/gpt-oss-120b or qwen/qwen3.6-27b,
# 8b-instant → openai/gpt-oss-20b. We run openai/gpt-oss-120b to match the
# ids foodscholar migrated to, so the platform carries one reasoning family
# and one set of quirks rather than two. NOTE: neither service had deployed
# gpt-oss when this landed — foodscholar's handling is committed but its
# manifest block was still unshipped — so this pair is unvalidated against
# live Groq. Watch for a response that isn't parseable JSON.
# qwen/qwen3.6-27b is the cheaper fallback if cost becomes the binding
# constraint — roughly a dozen agent calls plus the batch grader per turn.
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b
GROQ_DEFAULT_TEMPERATURE=0.0
# A ceiling, and a floor is applied per model family: reasoning models
# (gpt-oss, qwen3, deepseek-r1) charge hidden reasoning against the same
# completion budget as the payload, so backend/model_profiles.py raises
# anything below 2048. Lowering this below that floor has no effect.
GROQ_DEFAULT_MAX_TOKENS=4096

# The five structured-output extractors (dietary tags, plan spec, seed dishes,
# preferences, edit commands) pick spans out of one message rather than
# reasoning, and most planning turns hit several of them. A small model is the
# right tool; set this equal to GROQ_DEFAULT_MODEL to collapse the tier.
FOODCHAT_FAST_MODEL=openai/gpt-oss-20b

# Fleet-wide override for the reasoning tier. Commented out on purpose: unset
# means "inherit GROQ_DEFAULT_*", which is what you want unless you are pinning
# a model for one environment.
# FOODCHAT_LLM_MODEL=qwen/qwen3.6-27b
# FOODCHAT_LLM_TEMPERATURE=0.0

# Prose temperature — a genuinely separate setting, not an override of the
# above. Applies to SimpleChatBot, ResponseWriter and PlanAnalyst: every agent
# that writes text the member reads.
FOODCHAT_CHATBOT_TEMPERATURE=0.7
FOODCHAT_CHATBOT_HISTORY_TURNS=12
FOODCHAT_MAX_RETRIES=3
# LLM-graded plan combinations per request (cost/latency bound)
FOODCHAT_MAX_PLANS_TO_SCORE=10
# Candidates requested per meal slot from RecipeWrangler
FOODCHAT_CANDIDATE_LIMIT=8

# -----------------------------------------------------------------------------
# RecipeWrangler (recipe candidates — src/services/candidates_client.py)
# -----------------------------------------------------------------------------
RECIPEWRANGLER_API_URL=http://recipewrangler:8001
RECIPEWRANGLER_TIMEOUT=60

# -----------------------------------------------------------------------------
# WiseFood platform (member profiles — src/backend/platform.py)
# -----------------------------------------------------------------------------
WISEFOOD_API_URL=https://wisefood.gr/rest
WISEFOOD_POOL_SIZE=5

# Authentication Option 1: Username/Password
WISEFOOD_USERNAME=your_username
WISEFOOD_PASSWORD=your_password

# Authentication Option 2: Keycloak client credentials (takes precedence)
# WISEFOOD_CLIENT_ID=foodchat
# WISEFOOD_CLIENT_SECRET=your_client_secret

# -----------------------------------------------------------------------------
# FoodScholar (nutrition-science answers — src/services/foodscholar_service.py)
# -----------------------------------------------------------------------------
FOODSCHOLAR_API_URL=http://foodscholar:8001
FOODSCHOLAR_TIMEOUT=90
# Sources retrieved per question (answer quality vs latency)
FOODSCHOLAR_TOP_K=5

# -----------------------------------------------------------------------------
# PostgreSQL pool tuning (only used when DATABASE_URL is postgresql://)
# -----------------------------------------------------------------------------
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800

# -----------------------------------------------------------------------------
# Langfuse LLM tracing + prompt management (optional — src/backend/observability.py)
# -----------------------------------------------------------------------------
# Tracing + managed prompts activate only when BOTH keys are set AND the
# langfuse>=3.0 package is installed; one key alone (or missing package) = off,
# and every helper degrades to a no-op. Keys belong in a K8s Secret, never here.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# Self-hosted host. Either name works: LANGFUSE_BASE_URL is the platform/
# FoodScholar convention (bridged onto the SDK's LANGFUSE_HOST at startup).
# Use the in-cluster service URL when Langfuse runs in the same cluster.
# LANGFUSE_BASE_URL=http://langfuse-web.langfuse.svc.cluster.local:3000
# LANGFUSE_HOST=http://langfuse-web.langfuse.svc.cluster.local:3000
