# =============================================================================
# FoodChat Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Groq API Configuration
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_api_key_here
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GROQ_DEFAULT_TEMPERATURE=0.0
GROQ_DEFAULT_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# FoodChat Agent Configuration
# -----------------------------------------------------------------------------
FOODCHAT_LLM_MODEL=llama-3.3-70b-versatile
FOODCHAT_LLM_TEMPERATURE=0.0
FOODCHAT_CHATBOT_TEMPERATURE=0.7
FOODCHAT_MAX_RETRIES=3
FOODCHAT_MAX_PLANS_TO_SCORE=5

# -----------------------------------------------------------------------------
# WiseFood Platform Configuration
# -----------------------------------------------------------------------------
WISEFOOD_API_URL=https://wisefood.gr/rest
WISEFOOD_POOL_SIZE=5

# Authentication Option 1: Username/Password
WISEFOOD_USERNAME=your_username
WISEFOOD_PASSWORD=your_password

# Authentication Option 2: Client Credentials (Keycloak)
# If both are set, client credentials take precedence
# WISEFOOD_CLIENT_ID=your_client_id
# WISEFOOD_CLIENT_SECRET=your_client_secret

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# SQLite (default, zero-config):
DATABASE_URL=sqlite:///./foodchat.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/foodchat

# Max messages per session before user must start a new one (default: 200)
# SESSION_MAX_MESSAGES=200

# -----------------------------------------------------------------------------
# Data Configuration
# -----------------------------------------------------------------------------
DATA_DIR=./data
CSV_HUMMUS_PATH=./data/data_kg.csv
CSV_CULINARY_PATH=./data/sample_CulinaryDB.csv
DATASET=hummus
DATA_TYPE=csv

# -----------------------------------------------------------------------------
# Retrieval Configuration
# -----------------------------------------------------------------------------
RETRIEVAL=similarity
VECTORSTORE=chroma
MAX_RETRIEVAL=3
SCORE_THRESHOLD=0.0

# -----------------------------------------------------------------------------
# Optional: Advanced RAG Configuration
# -----------------------------------------------------------------------------
# HYBRID_SEARCH=false
# KS_WEIGHT=0.5
# VS_WEIGHT=0.5
# LAMBDA_PARAM=0.5
# QUERY_METHOD=standard
# EMBEDDINGS=nomic-embed-text:latest
# MULTIQUERY_LLM_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# Optional: Neo4j Knowledge Graph
# -----------------------------------------------------------------------------
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_password

# -----------------------------------------------------------------------------
# Recipe Source Configuration
# -----------------------------------------------------------------------------
# RECIPE_SOURCE controls where candidate recipes are fetched from:
#   "neo4j" (default) - query the local Neo4j knowledge graph
#   "api"             - query the RecipeWrangler REST API
RECIPE_SOURCE=neo4j
# RECIPEWRANGLER_API_URL=http://localhost:8000
