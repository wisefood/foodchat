# =============================================================================
# FoodChat Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Every setting the service reads is listed here — if you add an os.getenv()
# anywhere in src/, document it in this file.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# -----------------------------------------------------------------------------
# Persistence (SQLite file by default; PostgreSQL DSN in production, M5)
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./foodchat.db
# DATABASE_URL=postgresql://user:password@localhost:5432/foodchat
SESSION_MAX_MESSAGES=200

# -----------------------------------------------------------------------------
# Groq LLM API (all agents — see src/agents.py, src/backend/groq.py)
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_api_key_here
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GROQ_DEFAULT_TEMPERATURE=0.0
GROQ_DEFAULT_MAX_TOKENS=4096

# Agent-level overrides
FOODCHAT_LLM_MODEL=llama-3.3-70b-versatile
FOODCHAT_LLM_TEMPERATURE=0.0
FOODCHAT_CHATBOT_TEMPERATURE=0.7
FOODCHAT_CHATBOT_HISTORY_TURNS=12
FOODCHAT_MAX_RETRIES=3
# LLM-graded plan combinations per request (cost/latency bound)
FOODCHAT_MAX_PLANS_TO_SCORE=10
# Candidates requested per meal slot from RecipeWrangler
FOODCHAT_CANDIDATE_LIMIT=8
# Pantry planning (food waste — src/services/pantry_service.py):
# on-hand ingredients forwarded to per-item candidate search, and candidates
# fetched per item (each item is one extra plan_meals round-trip)
FOODCHAT_PANTRY_ITEM_LIMIT=6
FOODCHAT_PANTRY_PER_ITEM_CANDIDATES=3

# -----------------------------------------------------------------------------
# RecipeWrangler (recipe candidates — src/services/candidates_client.py)
# -----------------------------------------------------------------------------
RECIPEWRANGLER_API_URL=http://recipewrangler:8001
RECIPEWRANGLER_TIMEOUT=60

# -----------------------------------------------------------------------------
# WiseFood platform (member profiles — src/backend/platform.py)
# -----------------------------------------------------------------------------
WISEFOOD_API_URL=https://wisefood.gr/rest
WISEFOOD_POOL_SIZE=5

# Authentication Option 1: Username/Password
WISEFOOD_USERNAME=your_username
WISEFOOD_PASSWORD=your_password

# Authentication Option 2: Keycloak client credentials (takes precedence)
# WISEFOOD_CLIENT_ID=foodchat
# WISEFOOD_CLIENT_SECRET=your_client_secret

# -----------------------------------------------------------------------------
# FoodScholar (nutrition-science answers — src/services/foodscholar_service.py)
# -----------------------------------------------------------------------------
FOODSCHOLAR_API_URL=http://foodscholar:8001
FOODSCHOLAR_TIMEOUT=90
# Sources retrieved per question (answer quality vs latency)
FOODSCHOLAR_TOP_K=5

# -----------------------------------------------------------------------------
# PostgreSQL pool tuning (only used when DATABASE_URL is postgresql://)
# -----------------------------------------------------------------------------
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800

# -----------------------------------------------------------------------------
# Langfuse LLM tracing + prompt management (optional — src/backend/observability.py)
# -----------------------------------------------------------------------------
# Tracing + managed prompts activate only when BOTH keys are set AND the
# langfuse>=3.0 package is installed; one key alone (or missing package) = off,
# and every helper degrades to a no-op. Keys belong in a K8s Secret, never here.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# Self-hosted host. Either name works: LANGFUSE_BASE_URL is the platform/
# FoodScholar convention (bridged onto the SDK's LANGFUSE_HOST at startup).
# Use the in-cluster service URL when Langfuse runs in the same cluster.
# LANGFUSE_BASE_URL=http://langfuse-web.langfuse.svc.cluster.local:3000
# LANGFUSE_HOST=http://langfuse-web.langfuse.svc.cluster.local:3000
